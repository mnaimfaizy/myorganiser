. .husky/common.sh

# Format uncommitted files once, restage so the commit includes the rewrite,

# then lint with static Nx output so failures stay readable for AI tools.
# Prettier does not understand .prisma, so the schema needs its own formatter
# or it drifts silently until some unrelated commit reindents every model.
corepack yarn format:write --uncommitted
(cd apps/backend/src && npx prisma format --schema prisma/schema >/dev/null)
git update-index --again
corepack yarn libs:markdown:check
corepack yarn docs:notes:check
# One aggregate runner for every cheap, file-reading Assertion Gate checker
# (readme, OpenAPI artifacts, agent map, vault pages, auth pages, sub-agent
# sync, ADR numbering, and gate coverage) in a single Node process. The
# meta-gate rides here too, and resolves this indirection so the checkers
# reached only through the aggregate still count as wired. Each `corepack yarn`
# invocation costs roughly 1.3s of overhead against roughly 350ms of actual
# checker work, so wiring these as separate hook lines would add about ten
# seconds to every commit to do about two seconds of checking (ADR 0043).
# The per-check npm scripts remain for isolated runs and readable CI steps.
corepack yarn gates:run
# The skill atlas asserts counts and verbatim descriptions about the skill system, so it rots
# the moment a skill is added, renamed, or given a new description. Gated on the sources it
# reads: an unrelated commit must not fail on drift it did not introduce. That list must include
# every input the check grew — the lockfile that names Upstream-Owned Skills, the two config
# files that must cover them, and the script itself. It did not, and the commit that scoped
# .gitattributes slipped through this gate untested as a result.
if ! git diff --cached --quiet --diff-filter=ACMRTD -- \
 .agents/skills \
 .github/agents \
 .claude/agents \
 AGENTS.md \
 docs/agents/skill-atlas.html \
 skills-lock.json \
 .prettierignore \
 .gitattributes \
 tools/scripts/check-skill-map.mjs
then
corepack yarn skills:map:check
fi
corepack yarn test:hygiene --staged
if ! git diff --cached --quiet --diff-filter=ACMRT -- \
 libs/web/ui/src/lib/components \
 libs/web/pages
then
corepack yarn component:hygiene --staged --max-warnings=0
fi
# House Explainer Pages carry accessibility and self-containment rules that a
# generalist ships wrong and a reader only discovers in a browser: a root-`<svg>`
# `<title>` covering the whole canvas got as far as users before anyone reported
# it. `--staged` filters to the roster itself, so a commit touching an unrelated
# HTML page under docs/ costs nothing. The roster-coverage half runs in CI, where
# the whole tree is visible (ADR 0046).
if ! git diff --cached --quiet --diff-filter=ACMRT -- 'docs/**/*.html'
then
corepack yarn design:hygiene --staged
fi
# The full tools/scripts suite set (ADR 0135) takes about 34s in one
# `node --test` run, so a tooling commit should pay for its own suite rather
# than the whole set — and a commit outside tooling should pay nothing.
# `tools/scripts/lib/tools-test-selection.mjs` is the pure decision: the
# suites staged directly, plus the suite paired by name with each staged
# script. CI's `tools:test` still runs the full set on every push and pull
# request, so this incomplete local selection is a speed trade-off, not the
# only place the full set runs.
corepack yarn tools:test:staged
# The five sandcastle atlas pages state constants that live as module-local literals in the
# two orchestrator files and in the slice-selection lib they share, as exports in
# sandcastle-resume.mjs and sandcastle-subagent-trace.mjs, and as JSON in the model policy,
# package.json, and the CI workflow. They rot the moment any of those move, and
# the checker passed green through the whole of #467 precisely because it asserted constants
# while the prose went false around them — so the guard must list every input it reads, plus
# the pages and the check script themselves, or an unrelated commit is failed by drift it did
# not introduce and a related one slips through untested.
if ! git diff --cached --quiet --diff-filter=ACMRTD -- \
 docs/sandcastle/dispatch-map.html \
 docs/sandcastle/waves.html \
 docs/sandcastle/gates.html \
 docs/sandcastle/logs.html \
 docs/sandcastle/resume.html \
 tools/scripts/check-sandcastle-map.mjs \
 tools/scripts/lib/sandcastle-resume.mjs \
 tools/scripts/lib/sandcastle-subagent-trace.mjs \
 tools/scripts/lib/sandcastle-slice-selection.mjs \
 tools/scripts/lib/sandcastle-outcome.mjs \
 tools/config/agent-model-policy.json \
 package.json \
 .github/workflows/ci.yml \
 .sandcastle/main.mts \
 .sandcastle/dispatch-waves.mts
then
corepack yarn sandcastle:map:check
fi
corepack yarn affected:lint --uncommitted --outputStyle=static
