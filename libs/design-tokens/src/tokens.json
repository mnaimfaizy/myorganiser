    },
    "body": {
      "$value": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily",
      "$description": "Body copy and UI labels."
    }
  },
  "font-weight": {
    "$description": "Weights a control label or emphasis may take in place of its type step's own weight — a 15px field label is body-sm at semibold. Inter loads 400–600; Plus Jakarta Sans 600–800.",
