  "color": {
    "$description": "Brand and semantic colors. Use these instead of hard-coded hex values.",
    "primary": {
      "$value": "{neutral.850}",
      "$type": "color",
      "$description": "Deep slate navy. Branding, primary text, grounding elements."
    },
    "secondary": {
      "$value": "{violet.600}",
      "$type": "color",
      "$description": "Electric purple. Cryptographic / secure-action CTAs."
    },
    "tertiary": {
      "$value": "{teal.700}",
      "$type": "color",
      "$description": "Trust teal. Sync and persistent privacy indicators."
    },
    "cyan": {
      "$value": "{cyan.500}",
      "$type": "color",
      "$description": "Action cyan. Active nodes and successful connections."
    },
    "destructive": {
      "$value": "{red.600}",
      "$type": "color",
      "$description": "Irreversible actions only (delete, purge). 4.8:1 on white, so a filled destructive control carries its label at AA; the red it replaced did not."
    },
    "warning": {
      "$value": "{amber.700}",
      "$type": "color",
      "$description": "Caution amber. The User should notice this, but nothing failed and nothing is irreversible — an unsent change, a state that needs attention before an action. Never for errors (use destructive) and never for an action that cannot be undone. 5.0:1 on white, so it passes AA as body text; the lighter amber it replaced did not. The dark-surface pairing is warning-on-dark."
    },
    "surface": {
      "$value": "{neutral.50}",
      "$type": "color",
      "$description": "Page background (lowest tonal tier)."
    },
    "surface-container": {
      "$value": "{neutral.150}",
      "$type": "color",
      "$description": "Footer, pill, neutral chip backgrounds."
    },
    "card": {
      "$value": "{neutral.0}",
      "$type": "color",
      "$description": "Card / container surface."
    },
    "border": {
      "$value": "{neutral.200}",
      "$type": "color",
      "$description": "Hairline borders for cards, inputs."
    },
    "muted": {
      "$value": "{neutral.500}",
      "$type": "color",
      "$description": "Secondary text, metadata."
    },
    "on-primary": {
      "$value": "{neutral.0}",
      "$type": "color"
    },
    "on-secondary": {
      "$value": "{neutral.0}",
      "$type": "color"
    },
    "secondary-on-dark": {
      "$value": "#A78BFA",
      "$type": "color",
      "$description": "Dark-surface pairing for secondary. Lighter than the light-mode violet rather than the same hue darkened — the light value is unreadable on a dark ground."
    },
    "cyan-on-dark": {
      "$value": "{cyan.400}",
      "$type": "color",
      "$description": "Dark-surface pairing for cyan."
    },
    "destructive-on-dark": {
      "$value": "#811D1D",
      "$type": "color",
      "$description": "Dark-surface pairing for destructive."
    },
    "error-edge-on-dark": {
      "$value": "#F87171",
      "$type": "color",
      "$description": "Dark-surface pairing for the error edge: the TextField edge and alert icon of a field in error. destructive-on-dark is a fill and reads at 2.04:1 as a mark on the dark background, so the edge takes its own lighter red. The error message itself is not red in dark; it takes the near-white error text role."
    },
    "scrim": {
      "$value": "rgba(15, 23, 42, 0.4)",
      "$type": "color",
      "$description": "The wash a modal or sheet lays over the screen behind it: primary at 40%. The one colour in this tier carrying alpha, because a scrim that is opaque is not a scrim — it is a surface."
    },
    "scrim-on-dark": {
      "$value": "rgba(0, 0, 0, 0.6)",
      "$type": "color",
      "$description": "Dark-surface pairing for scrim: black at 60%. Primary at 40% over a near-black ground does not separate the sheet from the page."
    },
    "warning-on-dark": {
      "$value": "#FBBD23",
      "$type": "color",
      "$description": "Dark-surface pairing for warning. 11.8:1 on the dark background."
    },
    "success": {
      "$value": "{green.700}",
      "$type": "color",
      "$description": "Confirmation green. Something the User did completed, or a connection is healthy. Never for an action prompt — that is primary or brand. 4.5:1 on white, so it passes AA as body text."
    },
    "success-on-dark": {
      "$value": "#4ADE80",
      "$type": "color",
      "$description": "Dark-surface pairing for success. Lighter than the light-mode green rather than the same hue darkened; a status colour has to sit on the surface it is read against."
    }
  },
  "font": {
    "$description": "Font family stacks.",
    "display": {
      "$value": "'Plus Jakarta Sans', 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily",
