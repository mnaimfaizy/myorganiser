      "$value": "700",
      "$type": "fontWeight"
    },
    "extrabold": {
      "$value": "800",
      "$type": "fontWeight"
    }
  },
  "type": {
    "$description": "Named type scale. Every step carries all four attributes — size, line height, weight, and letter-spacing — so a step is used whole rather than assembled at a call site. Letter-spacing is in em against that step's own size, which is what lets one value mean the same thing on the web and as a React Native point offset. The first seven steps were approved in the Mobile App v1 design (issue #908); label-sm, control-sm, input and value were added for the Web v2.0 design (PRD #1241), which the web builds to.",
    "display": {
      "$description": "Screen-owning title. One per screen at most.",
      "size": {
        "$value": "34px",
        "$type": "dimension"
      },
      "line-height": {
        "$value": "40px",
        "$type": "dimension"
      },
      "weight": {
        "$value": "800",
        "$type": "fontWeight"
      },
      "tracking": {
        "$value": "-0.02em",
        "$type": "dimension"
      }
    },
    "title-lg": {
      "$description": "Section title that opens a screen.",
      "size": {
        "$value": "28px",
        "$type": "dimension"
      },
      "line-height": {
        "$value": "34px",
        "$type": "dimension"
      },
      "weight": {
        "$value": "700",
        "$type": "fontWeight"
      },
      "tracking": {
        "$value": "-0.02em",
        "$type": "dimension"
      }
    },
