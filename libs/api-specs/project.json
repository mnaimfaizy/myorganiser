{
  "name": "api-specs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-specs/src",
  "projectType": "library",
  "tags": ["type:util", "scope:shared", "tier:auto"],
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "yarn run api-docs:generate",
          "node tools/scripts/sync-openapi-spec.ts",
          "nx run app-api-client:generate-sources"
        ],
        "parallel": false
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "nx run api-specs:sync",
          "node tools/scripts/git-assert-clean.ts"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["node tools/scripts/check-openapi-artifacts.ts"]
      }
    }
  }
}
