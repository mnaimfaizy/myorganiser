enum FeedbackReportKind {
  bug_report
  suggestion
}

enum FeedbackReportStatus {
  received
  under_review
  planned
  fixed
  shipped
  wont_do
  cannot_reproduce
}

/// A Bug Report or Suggestion a signed-in User sent about the product itself.
/// Plaintext by design and never part of a Vault. It outlives User Deletion
/// with the reporter link cleared (same mechanism as AdminAuditLog).
model FeedbackReport {
  id     String               @id @default(cuid())
  kind   FeedbackReportKind
  status FeedbackReportStatus @default(received)

  title            String
  description      String
  expected_outcome String?

  // Report Context — captured client-side and shown to the sender before sending.
  context_platform         String
  context_app_version      String
  context_browser          String
  context_operating_system String
  context_path             String
  context_sent_at          DateTime

  fix_notice_opt_in Boolean @default(true)

  tracking_issue_number Int?
  status_note           String?
  follow_up             String?
  release_tag           String?
  status_changed_at     DateTime?

  reporter_user_id String?
  reporter         User?   @relation("FeedbackReporter", fields: [reporter_user_id], references: [id], onDelete: SetNull)

  fix_notice_delivery FeedbackFixNoticeDelivery?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([reporter_user_id, created_at])
  @@index([status])
  @@index([kind])
  @@index([tracking_issue_number])
  @@index([created_at])
}

/// Idempotent delivery ledger: at most one Fix Notice per Feedback Report
/// (CONTEXT.md: Fix Notice). The unique key on report_id is claimed before
/// the mail is handed to SMTP, mirroring YouTubeDigestDelivery's
/// claim-then-send pattern.
model FeedbackFixNoticeDelivery {
  id         String    @id @default(cuid())
  report_id  String    @unique
  /// claimed | sent | failed
  status     String    @default("claimed")
  sent_at    DateTime?
  error      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  report FeedbackReport @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@index([report_id])
}
