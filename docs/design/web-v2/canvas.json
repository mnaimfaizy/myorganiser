    "taskNotes": {
      "maxH": 520,
      "page": "tasks",
      "text": "Decisions in this page:\n• Tick to complete: the checkbox moves a Task to done (closedAt set), Undo in the toast.\n• Groups: Overdue, Today, Upcoming, No date — then Done collapsed.\n• Description and estimated minutes finally get UI.\n• Status shows as a pill only when it is not the default (In progress, Blocked).\n• Filters: context segmented + status chips; archived behind a chip.\n• Same sort inside a group as today: priority, then due, then created.",
      "w": 380,
      "x": 4560,
      "y": 0
    },
    "taskPhone": {
