    "grocNotes": {
      "maxH": 520,
      "page": "groceries",
      "text": "Decisions in this page:\n• Words follow CONTEXT.md: Grocery List (never \"trip\"), Catalog Item, Uncheck All, Remove Checked, Delete Grocery List.\n• Lines group by category in shop-walk order (GROCERY_CATEGORY_ORDER).\n• An empty list says so — no more \"All checked\".\n• The Catalog is its own tab, so it is reachable with zero lists.\n• Totals unchanged: a line counts its Catalog Item price once; Amount is a label. Multiplying by amount would be a domain change.",
      "w": 380,
      "x": 6080,
      "y": 0
    },
    "grocPhone": {
      "kind": "title1",
