APP_FRONTEND_URL=http://localhost:4200
ACCESS_JWT_SECRET=
REFRESH_JWT_SECRET=
VERIFY_JWT_SECRET=
RESET_JWT_SECRET=

# Optional: elevate an existing User (by email) to platform_admin on backend startup.
# Idempotent; does not create the account. Leave empty after the first admin exists.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# Server
NODE_ENV=development
PORT=3000
ROUTER_PREFIX=/api/v1

# Reverse proxy (recommended in production)
# If behind a reverse proxy/load balancer (cPanel Passenger, Nginx, Cloudflare), set this.
# Values:
# - 1 (recommended) trust first proxy hop
# - true trust all proxies
# - 0/false disable
TRUST_PROXY=1

# cPanel Passenger base URI (only needed when Passenger mounts the app under a
# base path). Requests then arrive with that prefix, which main.ts strips
# before matching routes. Leave empty outside that hosting setup.
PASSENGER_BASE_URI=


# Version Floor (ADR 0114): the lowest Mobile Release (X.Y.Z) this environment
# still serves. Empty or unset turns the check off. Mobile App requests below
# it get HTTP 426. An invalid value turns the check off and logs an error. Web app
# requests are never refused by this setting. Read at startup; restart to apply.
MOBILE_VERSION_FLOOR=

# Optional: global API rate limiting (recommended in production)
# Uses in-memory counters by default; for multi-instance deployments you should use a shared store (e.g. Redis).
# Store docs: https://express-rate-limit.mintlify.app/reference/stores
ENABLE_GLOBAL_RATE_LIMIT=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Comma-separated list of allowed origins (no trailing slashes)
# Example (staging/prod): https://myorganiser.app,https://www.myorganiser.app
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# POSTGRESQL DATABASE
DATABASE_USER=postgres
DATABASE_PASSWORD=Admin@123
DATABASE_NAME=myorganiser

DATABASE_URL=postgresql://postgres:Admin%40123@localhost:5453/myorganiser

# PgAdmin 
PGADMIN_DEFAULT_EMAIL=admin@myorganiser.com
PGADMIN_DEFAULT_PASSWORD=Admin@123

# Mail - SMTP
MAIL_SERVICE=smtp
DEFAULT_EMAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1453
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_SENDER=no-reply@myorganiser.local

# Mail - Gmail (only read when DEFAULT_EMAIL_PROVIDER=gmail)
GMAIL_USERNAME=
GMAIL_PASSWORD=

# Frontend (Next.js)
# Preferred (runtime): set this in cPanel Node.js App env vars.
# Example (prod): https://api.myorganiser.app/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# Fallback (build-time): used mainly for local builds/dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Local dev only: hostnames besides localhost allowed to load `next dev`'s
# dev resources (HMR), comma-separated, no scheme or port. Set your machine's
# LAN address (e.g. 192.168.1.7) to open the dev server from a phone. Never
# needed in a deployment.
NEXT_ALLOWED_DEV_ORIGINS=

# Operator identity for the public privacy policy and terms of service pages.
# An Operator Fingerprint (ADR 0086) — read at request time, never hardcoded.
# Leave both empty to render those pages with no operator details rather than
# a placeholder that looks real.
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=

# YouTube Integration (Google OAuth + API)
# Create credentials at https://console.cloud.google.com/apis/credentials

# Explicit backend switch (ADR 0091). Unset or false: every YouTube route
# 404s except the two cron endpoints, which succeed and do nothing, and the
# public GET /youtube/availability report, which says YouTube is
# unavailable. Defaults to unavailable when unset.
YOUTUBE_AVAILABLE=false

# Lifetime ceiling on Users ever granted YouTube Access by a Platform Admin
# (ADR 0129). A grant to a User never granted before is refused once this
# many Users have been granted. Re-granting a past User takes no place.
# Unset, blank, or not a positive integer means 25.
YOUTUBE_ACCESS_CEILING=25

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In production, when YOUTUBE_AVAILABLE is true, the backend refuses to
# start unless this is https, is not localhost, and shares
# APP_FRONTEND_URL's origin (ADR 0091). Outside production, or with the
# switch off, no validation runs.
GOOGLE_REDIRECT_URI=http://localhost:4200/dashboard/youtube/callback

# Vault Cloud Backup (Google Drive, browser-side GIS)
# Public OAuth client id inlined into the frontend at build time. Required
# to enable the cloud backup UI on /dashboard/vault. Empty means the card
# shows "not configured" — that is the off switch; there is no YouTube-style
# availability flag. Development and staging may share GOOGLE_CLIENT_ID's
# Testing-project client; production uses its own Cloud project (ADR 0091).
# After production enable the value is sticky: appDataFolder is per OAuth
# application, so changing it hides existing Escape Copies. The
# window.__MYORG_GOOGLE_CLIENT_ID__ fallback is E2E/dev only, not a
# production configuration path. Safe to expose; it is sent to the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 64-char hex key for encrypting YouTube OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Shared secret for the /youtube/cron/sync and /youtube/cron/digest endpoints.
YOUTUBE_CRON_SECRET=

# Production deploy credential for POST /feedback/releases/mark (ADR 0133).
# Sent as X-Deploy-Secret. Separate from YOUTUBE_CRON_SECRET; unset disables the endpoint.
FEEDBACK_RELEASE_SECRET=

# Base URL the cron wrapper (tools/scripts/youtube-cron.sh) posts to, including
# the API version prefix. Only needed on the host that runs the cron jobs.
YOUTUBE_API_BASE_URL=http://localhost:3000/api/v1