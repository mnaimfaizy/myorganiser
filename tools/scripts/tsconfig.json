{
  // ADR 0135's expand step: `tools/scripts` moves to strict TypeScript run by
  // Node's type stripping, not `tsx` and not a build step, so `module` and
  // `moduleResolution` are `nodenext` rather than the base tsconfig's
  // deprecated `node` — this config does not extend tsconfig.base.json at
  // all, so it never inherits that setting by accident.
  //
  // `allowJs`/`checkJs: false` let a migrated `.ts` file import a module
  // that is not TypeScript (e.g. `check-upstream-briefs.ts` ->
  // `.agents/skills/upstream-brief/report.mjs`, which ADR 0135 leaves out of
  // the migration) without TS7016: the import resolves and the `.mjs` file is
  // not itself type-checked. ADR 0135 promises `.ts` and `.mjs` import each
  // other in both directions under type stripping; this is what makes that
  // true for the type checker too.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"]
}
